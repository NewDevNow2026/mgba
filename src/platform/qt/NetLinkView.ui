   <item row="3" column="0" colspan="3">
    <widget class="QCheckBox" name="fastLink">
     <property name="text">
      <string>Fast link (speculative; exact mode is used automatically when a prediction fails)</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
