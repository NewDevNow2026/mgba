  <property name="windowTitle">
   <string>Network link cable</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0" colspan="3">
    <widget class="QLabel" name="help">
     <property name="text">
      <string>Links up to four games over the local network as if they were connected with a link cable. One player hosts a room; the others join with the host's IP address. Then use the game's own link feature (e.g. the Cable Club).</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
