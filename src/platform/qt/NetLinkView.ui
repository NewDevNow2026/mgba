    <widget class="QSpinBox" name="port">
     <property name="minimum">
      <number>1024</number>
     </property>
     <property name="maximum">
      <number>65535</number>
     </property>
     <property name="value">
      <number>29730</number>
     </property>
    </widget>
   </item>
   <item row="1" column="2">
